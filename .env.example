# ── Anthropic → OpenAI Proxy — Example Environment File ──────────────────────
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control (it contains your real API key).
# ──────────────────────────────────────────────────────────────────────────────

# ── Upstream OpenAI-compatible LLM ────────────────────────────────────────────
# URL of the OpenAI-compatible API this proxy wraps.
# Swap this to use any OpenAI-compatible provider — examples:
#
#   NVIDIA NIM (default):
#     LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#
#   Together AI:
#     LLM_BASE_URL=https://api.together.xyz/v1
#
#   Groq:
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#
#   OpenRouter:
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#
#   Local Ollama:
#     LLM_BASE_URL=http://localhost:11434/v1
#
#   Local LM Studio:
#     LLM_BASE_URL=http://localhost:1234/v1
#
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# API key for the upstream provider (get from their dashboard).
# For local providers (Ollama, LM Studio) any non-empty string works.
LLM_API_KEY=your_api_key_here

# ── Proxy connection details (use these in any Anthropic-compatible client) ────
#
#   Claude Code CLI:
#     set ANTHROPIC_BASE_URL=http://localhost:20128
#     set ANTHROPIC_API_KEY=proxy
#     claude
#
#   Python Anthropic SDK:
#     import anthropic
#     client = anthropic.Anthropic(
#         base_url="http://localhost:20128",
#         api_key="proxy"
#     )
#
#   curl:
#     curl http://localhost:20128/v1/messages \
#       -H "x-api-key: proxy" \
#       -H "anthropic-version: 2023-06-01" \
#       -H "Content-Type: application/json" \
#       -d '{"model":"any-string","max_tokens":128,"messages":[{"role":"user","content":"Hello"}]}'
#
ANTHROPIC_BASE_URL=http://localhost:20128
ANTHROPIC_API_KEY=proxy

# ── Model ─────────────────────────────────────────────────────────────────────
# The model name sent to the upstream API. Must be a valid name for your provider.
#
#   NVIDIA NIM models:
#     nvidia/nemotron-3-super-120b-a12b        ← fast & capable (recommended)
#     nvidia/gpt-oss-120b
#     nvidia/llama-3.1-nemotron-ultra-253b-v1  ← largest, slowest
#     mistralai/mistral-large-2-instruct
#     meta/llama-3.1-70b-instruct              ← smallest, fastest
#
#   Together AI example:    meta-llama/Llama-3-70b-chat-hf
#   Groq example:           llama3-70b-8192
#   OpenRouter example:     anthropic/claude-3-haiku
#   Ollama example:         llama3
#
MODEL=nvidia/nemotron-3-super-120b-a12b

# ── Proxy tuning ──────────────────────────────────────────────────────────────
# Port the proxy listens on (Claude Code default expects 20128)
PROXY_PORT=20128

# Max requests/min sent upstream. Lower this if your provider has a tighter limit.
# Set to a very high number (e.g. 9999) for providers with no rate limit.
PROXY_RATE_LIMIT_RPM=38

# Seconds to wait for the upstream LLM before aborting (300 = 5 minutes)
PROXY_TIMEOUT_SECONDS=300
